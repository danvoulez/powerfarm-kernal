# Powerfarm macOS LAB install config.
# Copy to deploy/macos/powerfarm.env or another private path and fill secrets.

POWERFARM_HOME=/Volumes/LAB-8/powerfarm
POWERFARM_DOMAIN=powerfarm.app
POWERFARM_API_HOSTNAME=api.powerfarm.app
POWERFARM_APP_HOSTNAME=app.powerfarm.app
POWERFARM_BIND_HOST=127.0.0.1
POWERFARM_PORT=8000
POWERFARM_PYTHON=python3.12

# MCP 2026-07-28 stateless protected-resource boundary.
POWERFARM_AUTH_REQUIRED=true
POWERFARM_MCP_RESOURCE_URL=https://api.powerfarm.app/mcp
POWERFARM_MCP_SCOPES=powerfarm.kernel
POWERFARM_OAUTH_ISSUER=https://wcguhgyiaphigiduyjpx.supabase.co/auth/v1
POWERFARM_OAUTH_AUDIENCE=powerfarm-kernel
POWERFARM_OAUTH_JWKS_URL=https://wcguhgyiaphigiduyjpx.supabase.co/auth/v1/.well-known/jwks.json
POWERFARM_OAUTH_ALGORITHMS=ES256,RS256
POWERFARM_ROOT_IDENTITY_HASH=
POWERFARM_RULES=genesis.root_authority

# Supabase Postgres. Use the pooler or direct Postgres URL.
DATABASE_URL=
SUPABASE_PROJECT_REF=wcguhgyiaphigiduyjpx
SUPABASE_URL=https://wcguhgyiaphigiduyjpx.supabase.co
# Store these with deploy/macos/secrets.sh; env values are fallback only.
SUPABASE_ACCESS_TOKEN=
SUPABASE_SECRET_KEY=
POWERFARM_LEDGER_BUCKET=powerfarm-ledger
POWERFARM_PACKAGES_BUCKET=powerfarm-packages

# Cloudflare Tunnel. Run `cloudflared tunnel login` once before install.
CLOUDFLARE_TUNNEL_NAME=powerfarm-lab
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CREDENTIALS_FILE=

# Pull-based release updater. The public repository needs no read token.
POWERFARM_GITHUB_REPOSITORY=danvoulez/powerfarm-kernal
POWERFARM_UPDATE_CHANNEL=stable
POWERFARM_UPDATE_INTERVAL=300

# Agent/model key is reserved for later agent wiring.
GOOGLE_API_KEY=
